---
import { articleUrl, dateLabel, readingTime, type Post } from '../lib/posts';
interface Props { post: Post; }
const { post } = Astro.props;
---
<article class="post-row"><div class="post-date"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>{readingTime(post.body)} 分钟阅读</span></div><div class="post-copy"><div class="post-tags">{post.data.tags.map(tag => <span>{tag}</span>)}{post.data.example && <span class="sample-label">示例文章</span>}</div><h3><a href={articleUrl(post)}>{post.data.title}</a></h3><p>{post.data.description}</p></div><a class="row-arrow" href={articleUrl(post)} aria-label={`阅读：${post.data.title}`}>↗</a></article>
