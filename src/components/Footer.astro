---
import { siteConfig } from '../site.config';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <span class="footer-name">{siteConfig.name}</span>
      <span class="footer-line">{siteConfig.intro[0]}</span>
    </div>
    <div class="footer-right">
      <span>© {new Date().getFullYear()} {siteConfig.author}. All rights reserved.</span>
      {siteConfig.icp && <span class="footer-icp">{siteConfig.icp}</span>}
    </div>
  </div>
</footer>
