---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../site.config';

const all = (await getCollection('posts'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const cat = Astro.url.searchParams.get('cat') || '';
const list = cat ? all.filter((p) => p.data.category === cat) : all;
const catDesc = cat ? siteConfig.categories.find((c) => c.name === cat)?.desc : undefined;

const byYear = {};
for (const p of list) {
  const y = String(p.data.date.getFullYear());
  (byYear[y] = byYear[y] || []).push(p);
}
const years = Object.keys(byYear).sort((a, b) => b.localeCompare(a));

function fmt(d) {
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${d.getFullYear()}-${m}-${day}`;
}
---
<BaseLayout
  title={cat ? `栏目 · ${cat}` : '归档'}
  description={catDesc ?? '按时间倒序排列的全部文章，共 ' + list.length + ' 篇。'}
>
  <section class="page">
    <div class="page-head">
      <h1>{cat ? `栏目 · ${cat}` : '归档'}</h1>
      <p>按时间倒序排列的全部文章，共 {list.length} 篇。</p>
    </div>

    <div class="archive-chips">
      <a class="chip" class:list={[{ active: !cat }]} href="/archive/">全部</a>
      {siteConfig.categories.map((c) => (
        <a
          class="chip"
          class:list={[{ active: cat === c.name }]}
          href={`/archive/?cat=${encodeURIComponent(c.name)}`}
        >
          {c.name}
        </a>
      ))}
    </div>

    {years.map((y) => (
      <div class="archive-group">
        <h2>{y} 年 <span class="n">{byYear[y].length} 篇</span></h2>
        <div class="archive-list">
          {byYear[y].map((p) => (
            <a class="archive-item" href={`/posts/${p.id}/`}>
              <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
              <span class="t">{p.data.title}</span>
              <span class={`tag-chip cat-${p.data.category}`}>{p.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>
