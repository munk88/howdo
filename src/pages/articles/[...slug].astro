---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { posts, dateLabel, readingTime, tagUrl, articleUrl, type Post } from '../../lib/posts';
import { site } from '../../config';
export async function getStaticPaths() { const all=await posts(); return all.map((post,i)=>({params:{slug:post.id},props:{post,next:all[(i+1)%all.length]}})); }
interface Props { post: Post; next?: Post; }
const {post,next}=Astro.props; const {Content,headings}=await render(post);
const json = {'@context':'https://schema.org','@type':'BlogPosting',headline:post.data.title,description:post.data.description,datePublished:post.data.date.toISOString(),dateModified:(post.data.updated??post.data.date).toISOString(),mainEntityOfPage:new URL(articleUrl(post),site.url).href};
---
<Layout title={post.data.title} description={post.data.description}><div class="page-width article-shell"><a class="back-link" href="/articles/">← 返回文章归档</a><header class="article-header"><div class="article-tags">{post.data.tags.map(tag=><a href={tagUrl(tag)}>{tag}</a>)}</div><h1>{post.data.title}</h1><p class="article-summary">{post.data.description}</p><div class="article-meta"><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>约 {readingTime(post.body)} 分钟</span>{post.data.updated && <span>更新于 {dateLabel(post.data.updated)}</span>}</div></header><div class="article-grid"><article class="prose">{post.data.example && <aside class="example-notice"><strong>示例文章</strong>这是一篇用于展示博客排版和写作方式的指南，不代表站主的个人经历或已完成的实验。</aside>}<Content/>{next && next.id!==post.id && <div class="next-article"><span>继续阅读</span><a href={articleUrl(next)}>{next.data.title} →</a></div>}</article><aside class="toc"><span>本篇目录 / ON THIS PAGE</span><nav aria-label="文章目录">{headings.filter(h=>h.depth===2 || h.depth===3).map(h=><a class:list={{'toc-sub':h.depth===3}} href={`#${h.slug}`}>{h.text}</a>)}</nav><a class="toc-top" href="#main">回到顶部 ↑</a></aside></div></div><script type="application/ld+json" set:html={JSON.stringify(json).replaceAll('<','\u003c')}/></Layout>
