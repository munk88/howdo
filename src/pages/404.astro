---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面不存在">
  <section class="page" style="text-align:center;padding-top:110px;">
    <div class="empty">
      <strong>页面不存在</strong>
      它可能已被移动或删除，<a href="/" style="color:var(--accent-ink);text-decoration:underline;">返回首页</a>
    </div>
  </section>
</BaseLayout>
