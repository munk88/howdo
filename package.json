{
  "name": "howdo-icu-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check:site": "node scripts/check-site.mjs",
    "new": "node scripts/new-post.mjs",
    "package": "npm run build && npm run check:site && node scripts/package.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "cheerio": "1.1.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
