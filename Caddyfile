# ============================================================
# Caddy 站点配置
# 你的域名：howdo.icu（Caddy 会自动签发并续期 HTTPS 证书）
# ============================================================
howdo.icu {
	root * /srv
	encode gzip
	file_server
	try_files {path} {path}/ /404.html

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
